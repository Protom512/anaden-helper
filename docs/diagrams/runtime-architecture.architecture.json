  "cards": [
    {
      "dot": "cyan",
      "title": "エントリポイント & UI 層",
      "items": [
        "anaden CLI はライブ実行・コールドスタート CI ゲート・検証ツールを提供",
        "anaden-studio は egui による ROI 作成・バッチ混同行列評価・ログ監視を提供"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sense → Think → Act エンジン",
      "items": [
        "PipelineDriver がキャプチャ・照合・発火・誠実検証（発火後確認）ループを駆動",
        "VisionEngine は SSE / TM_CCOEFF_NORMD と Lanczos3 720p 基準スケーリングを提供"
      ]
    },
    {
      "dot": "violet",
      "title": "デバイス適合層",
      "items": [
        "Android アダプタは adb exec-out と scrcpy タッチ注入でアンチチートを回避",
        "Windows アダプタは PrintWindow (GDI) と SendInput で AnotherEden.exe を直接制御"
      ]
    },
    {
      "dot": "amber",
      "title": "信頼性と安全性",
      "items": [
        "発火後検証（誠実検証）によりタップ空振り時の誤ったタスク遷移を排除",
        "連続 NoMatch 検出時の自動コールドスタート再起動でスタック状態から自律回復"
      ]
    }
  ]
}
