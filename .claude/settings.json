{
  "env": {
    "CARGO_BUILD_JOBS": "4"
  },
  "permissions": {
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git checkout .*)",
      "Bash(git restore .*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push origin +*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git clean *--force*)"
    ]
  },
  "enabledPlugins": {
    "understand-anything@understand-anything": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Documents/git-repo/anaden-helper/scripts/quality/commit_guard.mjs\" || exit 2",
            "timeout": 60,
            "statusMessage": "tests-untouched guard"
          }
        ]
      }
    ]
  }
}
