{
  "env": {
    "CARGO_BUILD_JOBS": "4"
  },
  "permissions": {
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git checkout .*)",
      "Bash(git restore .*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --all*)",
      "Bash(git push --mirror*)"
    ]
  },
  "enabledPlugins": {
    "understand-anything@understand-anything": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null)\" || exit 0; if ! node scripts/quality/assert_tests_untouched.mjs; then echo \"commit blocked: tests-untouched guard failed (test region touched)\" >&2; exit 2; fi",
            "timeout": 60,
            "statusMessage": "tests-untouched guard"
          }
        ]
      }
    ]
  }
}
